<Window x:Class="AntiCheatApp.LockdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lockdown" Topmost="True" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowState="Maximized" Background="Black" Loaded="Window_Loaded" Closing="Window_Closing">

    <Grid Background="Black">
        <TextBlock Text="LOCKDOWN" Foreground="#1AFFFFFF" FontSize="56" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>

        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,24"
                Background="#CC00BCD4" CornerRadius="10" Padding="24,12">
            <TextBlock Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Center" MaxWidth="720" TextWrapping="Wrap"
                       Text="LOCKDOWN — Press Q to exit. Task Manager, Lock (Win+L), Sign out, and Switch user are restricted. Ctrl+Alt+Del is reserved by Windows and cannot be disabled from an app."/>
        </Border>
    </Grid>
</Window>
