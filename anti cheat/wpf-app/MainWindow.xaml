<Window x:Class="AntiCheatApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AntiCheatApp"
        Title="Exam Anti-Cheat"
        Height="720" Width="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Storyboard x:Key="StatusPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0.5" To="1" Duration="0:0:0.85" AutoReverse="True"/>
        </Storyboard>
    </Window.Resources>

    <Border Background="#0F172A" CornerRadius="24" BorderBrush="#334155" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Color="#000000" Opacity="0.45"/>
        </Border.Effect>

        <Grid Margin="28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#3B82F6" Margin="0,0,10,0"/>
                <TextBlock Text="SECURE EXAM CLIENT" Foreground="#94A3B8" FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>

            <Button Content="✕" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Foreground="#64748B" Background="Transparent" BorderThickness="0" FontSize="16"
                    Padding="8" Cursor="Hand" Click="OnExitClick"/>

            <Border Grid.Row="1" Background="#1E293B" CornerRadius="20" Padding="32" Margin="0,20,0,20" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Anti-cheat status" Foreground="#64748B" FontSize="12" HorizontalAlignment="Center"/>

                    <Grid Width="140" Height="140" HorizontalAlignment="Center" Margin="0,20,0,16">
                        <Ellipse x:Name="StatusRing" Width="140" Height="140" StrokeThickness="6" Fill="Transparent">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Stroke" Value="#EF4444"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PhaseName}" Value="Protected">
                                            <Setter Property="Stroke" Value="#22C55E"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PhaseName}" Value="Violation">
                                            <Setter Property="Stroke" Value="#F97316"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <Ellipse Width="100" Height="100" Fill="#0F172A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StatusHeadline}" Foreground="White" FontWeight="Bold" FontSize="12"
                                   TextWrapping="Wrap" TextAlignment="Center" Width="92" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusDetail}" Foreground="#CBD5E1" FontSize="12" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="0,0,0,20" MaxWidth="320"/>

                    <TextBlock Text="Turn Anti-Cheat ON" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <ToggleButton x:Name="AntiCheatToggle" Width="220" Height="56" HorizontalAlignment="Center"
                                  Cursor="Hand" Background="Transparent" BorderThickness="0"
                                  Checked="AntiCheatToggle_Checked" Unchecked="AntiCheatToggle_Unchecked">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Track" CornerRadius="28" Height="56" Background="#334155" Padding="4">
                                    <Grid>
                                        <Border x:Name="Knob" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                Background="#64748B"/>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Track" Property="Background" Value="#14532D"/>
                                        <Setter TargetName="Knob" Property="Background" Value="#22C55E"/>
                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                        <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>



                </StackPanel>
            </Border>

            <TextBlock Grid.Row="2" Text="Backend: localhost:3001 · Open Exam from the web page to launch secure exam mode in this app."
                       Foreground="#475569" FontSize="10" TextAlignment="Center" TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
