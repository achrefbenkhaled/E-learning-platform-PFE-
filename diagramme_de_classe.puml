@startuml Diagramme_de_Classe_LearnHub

skinparam defaultFontName Arial
skinparam shadowing false
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam nodesep 55
skinparam ranksep 45

skinparam class {
  BackgroundColor white
  BorderColor black
  ArrowColor black
}

title LearnHub Platform - Class Diagram (Aligned with Models)

legend right
Association: --
Directed Association: -->
Aggregation: o--
Composition: *--
Inheritance (Generalization): --|>
Realization: ..|>
Dependency: ..>
endlegend

package "Users & Access" {
  class User {
    +_id: ObjectId
    +email: String
    +passwordHash: String
    +firstName: String
    +lastName: String
    +roles: String[] {student|instructor|admin}
    +isVerified: Boolean
    +isFaceVerified: Boolean
    +faceData: String?
    +isActive: Boolean
    +resetPasswordToken: String?
    +resetPasswordExpires: Date?
    --
    +comparePassword(password): Boolean
    +toJSON(): Object
  }

  class InstructorRequest {
    +_id: ObjectId
    +userId: ObjectId
    +name: String
    +email: String
    +reason: String
    +experience: String
    +idCard: String
    +cv: String
    +diploma: String
    +status: pending|approved|rejected
    --
    +createRequest()
    +updateRequestStatus()
  }

  class Notification {
    +_id: ObjectId
    +userId: ObjectId
    +type: enrollment|message|like|comment|system|course_update
    +title: String
    +message: String
    +data: Mixed
    +link: String
    +read: Boolean
    --
    +markAsRead()
  }
}

package "Learning" {
  class Course {
    +_id: ObjectId
    +title: String
    +description: String
    +categories: String[]
    +instructor: ObjectId
    +price: Number
    +status: draft|published|archived
    +level: beginner|intermediate|advanced
    +type: standard|classroom
    +classCode: String?
    +finalTestId: ObjectId?
    --
    +createCourse()
    +updateCourse()
    +addReview()
  }

  class Session {
    +_id: ObjectId
    +courseId: ObjectId
    +title: String
    +videoUrl: String
    +pdfUrl: String?
    +order: Number
    +duration: Number
    +isPublished: Boolean
    +testId: ObjectId?
    --
    +createSession()
    +updateSession()
  }

  class Enrollment {
    +_id: ObjectId
    +userId: ObjectId
    +courseId: ObjectId
    +progress: Number (0..100)
    +completedSessions: ObjectId[]
    +status: active|completed|paused
    +isBlocked: Boolean
    +certificateEarned: Boolean
    --
    +enrollCourse()
    +toggleBlockStudent()
  }
}

package "Assessment & Proctoring" {
  class Test {
    +_id: ObjectId
    +title: String
    +description: String
    +courseId: ObjectId?
    +sessionId: ObjectId?
    +createdBy: ObjectId
    +type: quiz|final
    +questions: Question[]
    +settings: TestSettings
    +status: draft|published|archived
    --
    +createTest()
    +updateTest()
    +generateTestAI()
  }

  class Question <<embedded>> {
    +_id: ObjectId
    +type: multiple-choice|short-answer|essay|file-response
    +question: String
    +options: String[]
    +correctAnswer: String?
    +attachments: Attachment[]
    +points: Number
  }

  class Attachment <<embedded>> {
    +url: String
    +name: String
  }

  class TestSettings <<embedded>> {
    +duration: Number
    +passingScore: Number
    +shuffleQuestions: Boolean
    +showResults: Boolean
    +scheduledStartTime: Date?
    +scheduledEndTime: Date?
    +scheduleWindows: ScheduleWindow[]
    +openToPublic: Boolean
    +requireCamera: Boolean
    +requireAntiCheat: Boolean
  }

  class ScheduleWindow <<embedded>> {
    +startTime: Date
    +endTime: Date
  }

  class TestAttempt {
    +_id: ObjectId
    +testId: ObjectId
    +userId: ObjectId
    +responses: Response[]
    +score: Number
    +totalPoints: Number
    +percentage: Number
    +passed: Boolean
    +startedAt: Date
    +submittedAt: Date?
    +status: in-progress|submitted|completed|graded
    +sessionId: String?
    +proctoringData: ProctoringData
    --
    +startTest()
    +submitTest()
    +updateProctoring()
  }

  class Response <<embedded>> {
    +questionId: ObjectId
    +answer: String
    +isCorrect: Boolean
  }

  class ProctoringData <<embedded>> {
    +lookingAwayCount: Number
    +phoneDetectedCount: Number
    +multiplePersonsCount: Number
    +noPersonCount: Number
    +lookingAwayPercent: Number
    +phoneDetectionPercent: Number
    +unauthorizedPersonPercent: Number
    +noPersonPercent: Number
    +faceVerified: Boolean?
    +faceComparisonError: String?
  }
}

package "Community & Moderation" {
  class CommunityPost {
    +_id: ObjectId
    +authorId: ObjectId
    +title: String
    +content: String
    +category: announcement|discussion|question|resource
    +likes: ObjectId[]
    +comments: Comment[]
    +tags: String[]
    +views: Number
    +isPinned: Boolean
    --
    +createPost()
    +likePost()
    +addComment()
  }

  class Comment <<embedded>> {
    +_id: ObjectId
    +postId: ObjectId?
    +authorId: ObjectId
    +content: String
    +likes: ObjectId[]
  }

  class ChatMessage {
    +_id: ObjectId
    +senderId: ObjectId
    +roomId: String
    +content: String
    +attachmentUrl: String?
    +readBy: ObjectId[]
    +isDeleted: Boolean
    --
    +sendMessage()
    +markRoomAsRead()
  }

  class Report {
    +_id: ObjectId
    +reporter: ObjectId
    +reportedUser: ObjectId?
    +contentType: user|post|comment|chat|course
    +contentId: ObjectId
    +reason: Harassment|Spam|Inappropriate Content|Hate Speech|Other
    +description: String
    +status: pending|resolved|dismissed
    --
    +createReport()
    +updateReportStatus()
  }
}

' Core relations
Course "0..*" --> "1" User : instructor
Enrollment "0..*" --> "1" User : userId
Enrollment "0..*" --> "1" Course : courseId
Session "0..*" --> "1" Course : courseId
Course "1" -- "0..1" Test : finalTestId
Session "1" -- "0..1" Test : testId
Test "0..*" --> "1" User : createdBy
Test "1" *-- "1..*" Question
Question "1" *-- "0..*" Attachment
Test "1" *-- "1" TestSettings
TestSettings "1" *-- "0..*" ScheduleWindow
TestAttempt "0..*" --> "1" Test : testId
TestAttempt "0..*" --> "1" User : userId
TestAttempt "1" *-- "0..*" Response
TestAttempt "1" *-- "1" ProctoringData

' Community relations
CommunityPost "0..*" --> "1" User : authorId
CommunityPost "1" *-- "0..*" Comment
Comment "0..*" --> "1" User : authorId
ChatMessage "0..*" --> "1" User : senderId
Notification "0..*" --> "1" User : userId
Report "0..*" --> "1" User : reporter
Report "0..*" --> "0..1" User : reportedUser
InstructorRequest "0..*" --> "1" User : userId

@enduml
