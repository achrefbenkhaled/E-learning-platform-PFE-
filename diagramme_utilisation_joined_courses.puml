@startuml Diagramme_Student_Courses

left to right direction

' ================= CUSTOM SKINPARAM & STYLING =================
skinparam BackgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 12

skinparam actor {
    BackgroundColor #FFFFFF
    BorderColor #333333
    BorderThickness 1.5
    FontColor #000000
    FontSize 13
}

skinparam usecase {
    BackgroundColor #F2F5F7
    BorderColor #475569
    BorderThickness 1.2
    FontColor #000000
    FontSize 12
    ArrowColor #475569
    ArrowThickness 1.2
}

skinparam packageStyle rectangle
skinparam rectangle {
    BorderColor #475569
    BorderThickness 1.5
    FontColor #000000
    FontSize 14
    FontStyle bold
}

skinparam note {
    BackgroundColor #F8FAFC
    BorderColor #475569
    FontColor #000000
    FontSize 12
}

' ================= ACTORS =================
actor "Student" as S

' ================= SYSTEM BOUNDARY =================
rectangle "Courses Management (Student)" {

    usecase "Manage Courses" as ManageCourses

    ' --- The Two Main Options ---
    usecase "Discover Courses" as Discover
    usecase "Manage Joined Courses" as JoinedCourses

    Discover --|> ManageCourses
    JoinedCourses --|> ManageCourses

    ' --- Discover Courses Actions ---
    usecase "Search & Filter Courses" as SearchCourses
    usecase "Join Course" as JoinCourse
    
    SearchCourses ..> Discover : <<extend>>
    JoinCourse ..> Discover : <<extend>>
    JoinedCourses ..> JoinCourse : <<include>>

    ' --- Join Course Options (Generalizations) ---
    usecase "Enroll in Free Course" as EnrollFree
    usecase "Enroll in Paid Course" as EnrollPaid
    usecase "Join Classroom with Code" as JoinCode

    EnrollFree --|> JoinCourse
    EnrollPaid --|> JoinCourse
    JoinCode --|> JoinCourse

    ' --- After Joining (Options in Joined Courses) ---
    usecase "Access Session Content" as AccessSessions
    usecase "Access Course Chat" as AccessChat
    usecase "Track Progress" as TrackProgress
    usecase "Unenroll from Course" as Unenroll

    AccessSessions --|> JoinedCourses
    AccessChat --|> JoinedCourses
    TrackProgress --|> JoinedCourses
    Unenroll --|> JoinedCourses

    usecase "Review Course" as ReviewCourse
    ReviewCourse --|> JoinedCourses

}

S -- ManageCourses

note "All use cases require Login / Authentication" as AuthNote

@enduml
